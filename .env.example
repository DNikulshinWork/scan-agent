# ==============================================================================
# ScanAgent Monorepo Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# URL подключения к PostgreSQL (например, на Neon: https://neon.tech)
# Для Neon обязательно укажите sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/scanagent?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Fastify API Server
# ------------------------------------------------------------------------------
# Порт для входящих HTTP-запросов (Render автоматически прокидывает PORT=10000)
PORT=10000
NODE_ENV="production"

# Разрешенные CORS-источники (через запятую)
CORS_ORIGIN="https://dnikulshinwork.github.io,http://localhost:3000,http://localhost:5173"

# Секретный ключ для защиты вызовов внешнего планировщика cron-job.org
# Передаётся в заголовке Authorization: Bearer <CRON_SECRET> или ?token=<CRON_SECRET>
CRON_SECRET="your-strong-random-cron-secret-key-123"

# ------------------------------------------------------------------------------
# 3. Headless HH.ru Scanner & Automation
# ------------------------------------------------------------------------------
# Включен ли встроенный автосбор вакансий в фоне (true/false)
AUTO_SCAN_ENABLED=true

# Интервал автосбора в минутах (по умолчанию 30)
AUTO_SCAN_INTERVAL_MINUTES=30

# Максимальное количество страниц выдачи HH.ru для парсинга (по умолчанию 2)
HH_MAX_PAGES=2

# Кастомный поисковый URL с фильтрами HH.ru (опционально)
HH_SEARCH_URL="https://hh.ru/search/vacancy?text=frontend+OR+fullstack&salary=150000&only_with_salary=true&schedule=remote"

# ------------------------------------------------------------------------------
# 4. Real Web Push Notifications (RFC 8291 / VAPID)
# ------------------------------------------------------------------------------
# Публичный VAPID-ключ для подписки клиентов в браузере
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBKr3qBUYIHBQFLXYp5Nksh8U"

# Приватный VAPID-ключ для подписи push-сообщений бэкендом
VAPID_PRIVATE_KEY="your-private-vapid-key-secret"

# Контактный email или URL для идентификации сервера в VAPID (mailto:... или https://...)
VAPID_SUBJECT="mailto:d.nikulshin.dev@gmail.com"

# ------------------------------------------------------------------------------
# 5. Dashboard PWA (Next.js / Vite)
# ------------------------------------------------------------------------------
# Публичный URL задеплоенного бэкенда Fastify API (Render / VPS)
NEXT_PUBLIC_API_URL="https://scan-agent-api.onrender.com"

# ------------------------------------------------------------------------------
# 6. CI/CD & Deployments
# ------------------------------------------------------------------------------
# Webhook для запуска автоматического деплоя на Render
RENDER_DEPLOY_HOOK_URL="https://api.render.com/deploy/srv-danv04oae00c73a5vv10?key=lKtY2NRDKUc"
